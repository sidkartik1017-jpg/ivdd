# Copy this file to backend/.env and fill in values.
# Every setting has a safe default, so the app runs even with an empty .env.

# --- Security ---
# Use a long random string in production, e.g. `python -c "import secrets;print(secrets.token_hex(32))"`
SECRET_KEY=dev-secret-change-me
JWT_EXPIRES_HOURS=72

# --- Database (Neon.tech Postgres) ---
# Leave unset to use a local SQLite file (backend/spineguard.db).
# Neon example (note sslmode=require):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- ML model ---
# Absolute path or path relative to the backend dir. Defaults to the repo-root pkl.
# MODEL_PATH=/app/ivdd_best_model.pkl

# --- GroqCloud (chatbot) ---
# Get a key at https://console.groq.com/keys . Without it, the chatbot uses
# built-in canned replies.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- CORS: allowed frontend origins (comma-separated) ---
CORS_ORIGINS="*"

# If 1, an unknown email signing in creates an account automatically (demo-friendly).
AUTO_SIGNUP=1
